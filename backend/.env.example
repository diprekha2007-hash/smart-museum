# SmartMuseum - Neo4j Aura Database Configuration
# Copy this file to backend/.env and replace the placeholders with your real Aura values.
# NEVER commit backend/.env.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=your_aura_username
NEO4J_PASSWORD=your_neo4j_aura_password_here
# Aura database name (shown in the Aura console; often equals the instance ID, not always "neo4j")
NEO4J_DATABASE=your_database_name
PORT=3001
